#!/usr/bin/env sh

if [ $# -eq 0 ]; then
	cd "$SECOND_BRAIN"/notes || exit 1
	nvim .
	exit 0
fi

open_file() {
	cd "$SECOND_BRAIN"/notes || exit 1
	nvim "${1}.md"
}

remove_file() {
	cd "$SECOND_BRAIN"/notes || exit 1
	if [ -f "${1}.md" ]; then
		rm "${1}.md"
	else
		echo "File didn't exist"
	fi
}

list_notes() {
  cd "$SECOND_BRAIN"/notes || exit 1
  eza --icons always --git --group-directories-first -l
}

if [ $# -eq 1 ]; then
  case "$1" in
"-l")
  list_notes
  exit 0
  ;;
*)
	open_file "$1"
	exit 0
  ;;
    esac
elif [ $# -ne 2 ]; then
	echo "You need to provide action and file name."
	exit 1
fi

case "$1" in
"-d")
	remove_file "$2"
	exit 0
	;;
*)
	exit 1
	;;
esac
