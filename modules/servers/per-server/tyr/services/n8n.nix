{
  pkgs,
  lib,
  ...
}: {
  # Containers
  virtualisation.oci-containers.containers."n8n-n8n" = {
    image = "docker.io/n8nio/n8n:2.40.6";
    environmentFiles = [
      "/var/lib/n8n/.env"
    ];
    volumes = [
      "/var/lib/n8n/n8n-data:/home/node/.n8n:rw"
    ];
    ports = [
      "5678:5678/tcp"
    ];
    dependsOn = [
      "n8n-sandbox-api"
    ];
    log-driver = "journald";
    extraOptions = [
      "--network-alias=n8n"
      "--network=n8n_default"
    ];
  };
  systemd.services."podman-n8n-n8n" = {
    serviceConfig = {
      Restart = lib.mkOverride 90 "no";
    };
    unitConfig.Description = "Container n8n-n8n generated by compose2nix.";
    after = [
      "podman-network-n8n_default.service"
    ];
    requires = [
      "podman-network-n8n_default.service"
    ];
    partOf = [
      "podman-compose-n8n-root.target"
    ];
    wantedBy = [
      "podman-compose-n8n-root.target"
    ];
  };
  virtualisation.oci-containers.containers."n8n-runners" = {
    image = "ghcr.io/n8n-io/runners:2.40.6";
    environmentFiles = [
      "/var/lib/n8n/.env"
    ];
    # Non-secret env (mirrors get-n8n-compose.yml runners service); N8N_RUNNERS_AUTH_TOKEN stays in .env
    environment = {
      N8N_RUNNERS_TASK_BROKER_URI = "http://n8n:5679";
    };
    dependsOn = [
      "n8n-n8n"
    ];
    log-driver = "journald";
    extraOptions = [
      "--network-alias=runners"
      "--network=n8n_default"
    ];
  };
  systemd.services."podman-n8n-runners" = {
    serviceConfig = {
      Restart = lib.mkOverride 90 "no";
    };
    unitConfig.Description = "Container n8n-runners generated by compose2nix.";
    after = [
      "podman-network-n8n_default.service"
    ];
    requires = [
      "podman-network-n8n_default.service"
    ];
    partOf = [
      "podman-compose-n8n-root.target"
    ];
    wantedBy = [
      "podman-compose-n8n-root.target"
    ];
  };
  virtualisation.oci-containers.containers."n8n-sandbox-api" = {
    image = "ghcr.io/n8n-io/n8n-sandbox-service-api:1.4.0";
    environmentFiles = [
      "/var/lib/n8n/.env"
    ];
    # Non-secret env (mirrors get-n8n-compose.yml sandbox-api environment block); API keys/tokens stay in .env
    environment = {
      SANDBOX_API_GRPC_TLS_CERT_FILE = "/tls/api/grpc-server.crt";
      SANDBOX_API_GRPC_TLS_KEY_FILE = "/tls/api/grpc-server.key";
      SANDBOX_API_GRPC_TLS_CLIENT_CA_FILE = "/tls/api/ca.crt";
      SANDBOX_API_RUNNER_CONTROL_GRPC_TLS_CA_FILE = "/tls/api/ca.crt";
      SANDBOX_API_RUNNER_CONTROL_GRPC_TLS_CERT_FILE = "/tls/api/control-grpc-api-client.crt";
      SANDBOX_API_RUNNER_CONTROL_GRPC_TLS_KEY_FILE = "/tls/api/control-grpc-api-client.key";
      SANDBOX_API_RUNNER_CONTROL_GRPC_TLS_SERVER_NAME = "sandbox-runner-1";
    };
    volumes = [
      "/var/lib/n8n/sandbox-tls:/tls:ro"
    ];
    dependsOn = [
      "n8n-sandbox-certs"
    ];
    log-driver = "journald";
    extraOptions = [
      "--health-cmd=[\"wget\", \"-qO-\", \"http://localhost:8080/healthz\"]"
      "--health-interval=5s"
      "--health-retries=5"
      "--health-start-period=10s"
      "--health-timeout=3s"
      "--network-alias=sandbox-api"
      "--network=n8n_default"
    ];
  };
  systemd.services."podman-n8n-sandbox-api" = {
    serviceConfig = {
      Restart = lib.mkOverride 90 "no";
    };
    unitConfig.Description = "Container n8n-sandbox-api generated by compose2nix.";
    after = [
      "podman-network-n8n_default.service"
    ];
    requires = [
      "podman-network-n8n_default.service"
    ];
    partOf = [
      "podman-compose-n8n-root.target"
    ];
    wantedBy = [
      "podman-compose-n8n-root.target"
    ];
  };
  virtualisation.oci-containers.containers."n8n-sandbox-certs" = {
    image = "ghcr.io/n8n-io/n8n-sandbox-service-api:1.4.0";
    environmentFiles = [
      "/var/lib/n8n/.env"
    ];
    volumes = [
      "/var/lib/n8n/sandbox-tls:/tls:rw"
    ];
    cmd = ["bootstrap-mtls.sh --out-dir /tls --api-san sandbox-api --control-san-prefix sandbox-runner --world-readable && chown -R sandbox-api:sandbox-api /tls/api && chmod -R a+rX /tls
  "];
    user = "0:0";
    log-driver = "journald";
    extraOptions = [
      "--entrypoint=[\"sh\", \"-c\"]"
      "--network-alias=sandbox-certs"
      "--network=n8n_default"
    ];
  };
  systemd.services."podman-n8n-sandbox-certs" = {
    serviceConfig = {
      Restart = lib.mkOverride 90 "no";
    };
    unitConfig.Description = "Container n8n-sandbox-certs generated by compose2nix.";
    after = [
      "podman-network-n8n_default.service"
    ];
    requires = [
      "podman-network-n8n_default.service"
    ];
    partOf = [
      "podman-compose-n8n-root.target"
    ];
    wantedBy = [
      "podman-compose-n8n-root.target"
    ];
  };
  virtualisation.oci-containers.containers."n8n-sandbox-runner-1" = {
    image = "ghcr.io/n8n-io/n8n-sandbox-service-runner-dind:1.4.0";
    environmentFiles = [
      "/var/lib/n8n/.env"
    ];
    # Non-secret env (mirrors get-n8n-compose.yml sandbox-runner-1 environment block); SANDBOX_RUNNER_API_KEYS and SANDBOX_RUNNER_REGISTRATION_TOKEN stay in .env (secrets)
    environment = {
      SANDBOX_RUNNER_API_GRPC_ADDR = "sandbox-api:9090";
      SANDBOX_RUNNER_HTTP_BASE_URL = "https://sandbox-runner-1:8080";
      SANDBOX_RUNNER_CONTROL_GRPC_LISTEN_ADDR = ":9091";
      SANDBOX_RUNNER_CONTROL_GRPC_ADVERTISE_ADDR = "sandbox-runner-1:9091";
      SANDBOX_RUNNER_ID = "runner-1";
      SANDBOX_RUNNER_DOCKER_SANDBOX_IMAGE = "ghcr.io/n8n-io/n8n-sandbox-service-sandbox:1.4.0";
      SANDBOX_RUNNER_REGISTRATION_GRPC_CA_FILE = "/tls/runner/ca.crt";
      SANDBOX_RUNNER_REGISTRATION_GRPC_CERT_FILE = "/tls/runner/grpc-client.crt";
      SANDBOX_RUNNER_REGISTRATION_GRPC_KEY_FILE = "/tls/runner/grpc-client.key";
      SANDBOX_RUNNER_REGISTRATION_GRPC_SERVER_NAME = "sandbox-api";
      SANDBOX_RUNNER_CONTROL_GRPC_TLS_CERT_FILE = "/tls/runner/control-grpc-server.crt";
      SANDBOX_RUNNER_CONTROL_GRPC_TLS_KEY_FILE = "/tls/runner/control-grpc-server.key";
      SANDBOX_RUNNER_CONTROL_GRPC_TLS_CLIENT_CA_FILE = "/tls/runner/ca.crt";
    };
    volumes = [
      "/var/lib/n8n/sandbox-tls:/tls:ro"
    ];
    dependsOn = [
      "n8n-sandbox-api"
    ];
    log-driver = "journald";
    extraOptions = [
      "--network-alias=sandbox-runner-1"
      "--network=n8n_default"
      "--privileged"
    ];
  };
  systemd.services."podman-n8n-sandbox-runner-1" = {
    serviceConfig = {
      Restart = lib.mkOverride 90 "no";
    };
    unitConfig.Description = "Container n8n-sandbox-runner-1 generated by compose2nix.";
    after = [
      "podman-network-n8n_default.service"
    ];
    requires = [
      "podman-network-n8n_default.service"
    ];
    partOf = [
      "podman-compose-n8n-root.target"
    ];
    wantedBy = [
      "podman-compose-n8n-root.target"
    ];
  };
  virtualisation.oci-containers.containers."n8n-searxng" = {
    image = "ghcr.io/searxng/searxng:latest";
    environmentFiles = [
      "/var/lib/n8n/.env"
    ];
    volumes = [
      "/var/lib/n8n/searxng-settings.yml:/etc/searxng/settings.yml:ro"
    ];
    log-driver = "journald";
    extraOptions = [
      "--network-alias=searxng"
      "--network=n8n_default"
    ];
  };
  systemd.services."podman-n8n-searxng" = {
    serviceConfig = {
      Restart = lib.mkOverride 90 "no";
    };
    unitConfig.Description = "Container n8n-searxng generated by compose2nix.";
    after = [
      "podman-network-n8n_default.service"
    ];
    requires = [
      "podman-network-n8n_default.service"
    ];
    partOf = [
      "podman-compose-n8n-root.target"
    ];
    wantedBy = [
      "podman-compose-n8n-root.target"
    ];
  };

  # Networks
  systemd.services."podman-network-n8n_default" = {
    unitConfig.Description = "Network n8n_default generated by compose2nix.";
    path = [pkgs.podman];
    serviceConfig = {
      Type = "oneshot";
      RemainAfterExit = true;
      ExecStop = "podman network rm -f n8n_default";
    };
    script = ''
      podman network inspect n8n_default || podman network create n8n_default
    '';
    partOf = ["podman-compose-n8n-root.target"];
    wantedBy = ["podman-compose-n8n-root.target"];
  };

  # Root service
  # When started, this will automatically create all resources and start
  # the containers. When stopped, this will teardown all resources.
  systemd.targets."podman-compose-n8n-root" = {
    unitConfig = {
      Description = "Root target generated by compose2nix.";
    };
    wantedBy = ["multi-user.target"];
  };
}
